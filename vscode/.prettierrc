{
    "overrides": [
        {
            "files": ["*.md", "*.css", "*.scss", "*.sass"],
            "options": {
                "tabWidth": 2
            }
        },
        {
            "files": ["*.ts", "*.tsx", "*.js", "*.jsx", "*.json", "*.jsonc", "*.py", "*.cpp", "*.sh"],
            "options": {
                "tabWidth": 4,
                "singleQuote": true,
                "printWidth": 120,
                "trailingComma": "es5"
            }
        },
        {
            "files": ["*.html", "*.tsx"],
            "options": {
                "tabWidth": 4
            }
        },
        {
            "files": ["*.yaml", "*.yml", "*.rb", "*.erb", "*.haml", "*.coffee", "*.sql"],
            "options": {
                "tabWidth": 2,
                "singleQuote": false
            }
        }
    ]
}
