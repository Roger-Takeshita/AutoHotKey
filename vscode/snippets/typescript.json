            "\t\tconst ${2:variable} = await ${3:Collection}.${4|find,findOne,findOneAndDelete,findByIdAndDelete,updateMany|}({ ${5:fields} });",
            "\t\tif (!${2:variable}$7) return res.status(${8|404,400|}).json({ message: '${9:msg}' });",
            "\t\t$0",
            "\t\tres.status(${10|200,201|}).json(${2:variable});",
            "\t} catch (error) {",
            "\t\tres.status(500).json({ message: 'Something went wrong', error });",
            "\t}",
            "};"
        ],
        "description": "Fetch MongoDB"
