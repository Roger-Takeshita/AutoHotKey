    "Print Message": {
        "prefix": "msg",
        "body": [
            "print_msg() {",
            "    local TYPE=\\$1",
            "    local MSG1=\\$2",
            "    local MSG2=\\$3",
            "",
            "    case \\${TYPE} in",
            "        'ERROR')",
            "            echo -e \"\\n   \\${BGRD}\\${FGWT} \\${TYPE}: \\${BGRST} \\${FGLRD}\\${MSG1}\\${FGRST}\"",
            "            [ \"\\${MSG2}\" != '' ] && echo -e \"            \\${FGLBL}\\${MSG2}\\${FGRST}\"",
            "            echo ''",
            "            exit 1",
            "            ;;",
            "        'WARNING')",
            "            echo -e \"\\n   \\${BGOG}\\${FGWT} \\${TYPE}: \\${BGRST} \\${FGLOG}\\${MSG1}\\${FGRST}\"",
            "            [ \"\\${MSG2}\" != '' ] && echo -e \"              \\${FGLBL}\\${MSG2}\\${FGRST}\"",
            "            echo ''",
            "            ;;",
            "        'SUCCESS')",
            "            echo -e \"\\n   \\${BGGN}\\${FGWT} \\${TYPE}: \\${BGRST} \\${FGLGN}\\${MSG1}\\${FGRST}\"",
            "            [ \"\\${MSG2}\" != '' ] && echo -e \"              \\${FGLBL}\\${MSG2}\\${FGRST}\"",
            "            echo ''",
            "            ;;",
            "        'DONE')",
            "            echo -e \"\\n   \\${BGGN}\\${FGWT} \\${TYPE}: \\${BGRST} \\${FGLGN}\\${MSG1}\\${FGRST}\"",
            "            [ \"\\${MSG2}\" != '' ] && echo -e \"           \\${FGLBL}\\${MSG2}\\${FGRST}\"",
            "            echo ''",
            "            ;;",
            "        'INFO')",
            "            echo -e \"\\n   \\${BGBL}\\${FGWT} \\${TYPE}: \\${BGRST} \\${FGRST}\\${MSG1}\"",
            "            [ \"\\${MSG2}\" != '' ] && echo -e \"           \\${FGLBL}\\${MSG2}\\${FGRST}\"",
            "            echo ''",
            "            ;;",
            "        *)",
            "            echo -e \"\\n   \\${TYPE}\\${BGRST}\\${FGRST}\"",
            "            [ \"\\${MSG1}\" != '' ] && echo -e \"   \\${MSG1}\\${BGRST}\\${FGRST}\"",
            "            [ \"\\${MSG2}\" != '' ] && echo -e \"   \\${MSG2}\\${BGRST}\\${FGRST}\"",
            "            echo ''",
            "            ;;",
            "    esac",
            "}"
        ],
        "description": "Print Message"
    },
    "Check Flags": {
        "prefix": "check_flags",
        "body": [
            "ARGS=\\$@",
            "",
            "check_flags() {",
            "\tlocal REGEX='([ ^]?(-(${1:flag})))'",
            "\t",
            "\tfor arg in \\$ARGS; do",
            "\t\tif [[ \\$arg =~ \\$REGEX ]]; then",
            "\t\t\tcase \\${BASH_REMATCH[2]} in",
            "\t\t\t\t'-${1:flag}')",
            "\t\t\t\t\tFLAG_1=1",
            "\t\t\t\t\t;;",
            "\t\t\tesac",
            "\t\tfi",
            "\tdone",
            "\t",
            "\tARGS=\\$(echo \\$ARGS | sed -E \"s/\\$REGEX//g\" | xargs)",
            "}",
            "",
            "check_flags \\$ARGS"
        ],
        "description": "Check Flags"
    }
}
