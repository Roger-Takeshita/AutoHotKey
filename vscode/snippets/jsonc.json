{
    "TypeScript Node.js Backend": {
        "prefix": "nodejs",
        "body": [
            "{",
            "\t\"compilerOptions\": {",
            "\t\t\"target\": \"ES6\",",
            "\t\t\"module\": \"commonjs\",",
            "\t\t\"allowJs\": true, ",
            "\t\t\"outDir\": \"./dist\",",
            "\t\t\"rootDir\": \"./src\",",
            "\t\t\"removeComments\": true,",
            "\t\t\"moduleResolution\": \"node\",",
            "\t\t\"noEmitOnError\": true,",
            "\t\t\"resolveJsonModule\": true,",
            "\t\t\"noFallthroughCasesInSwitch\": true,",
            "\t\t\"typeRoots\": [",
            "\t\t\t\"./node_modules/@types\",",
            "\t\t\t\"src/utils/@types\"",
            "\t\t],",
            "\t\t\"esModuleInterop\": true,",
            "\t\t\"skipLibCheck\": true,",
            "\t\t\"forceConsistentCasingInFileNames\": true,",
            "\t\t\"baseUrl\": \"./src\",",
            "\t\t\"paths\": {",
            "\t\t\t\"~/*\": [\"./*\"],",
            "\t\t\t\"@config/*\": [\"./config/*\"],",
            "\t\t\t\"@controllers/*\": [\"./controllers/*\"],",
            "\t\t\t\"@middlewares/*\": [\"./middlewares/*\"],",
            "\t\t\t\"@models/*\": [\"./models/*\"],",
            "\t\t\t\"@routes/*\": [\"./routes/*\"],",
            "\t\t\t\"@utils/*\": [\"./utils/*\"],",
            "\t\t\t\"@customTypes/*\": [\"./utils/@types/*\"],",
            "\t\t\t\"@helpers/*\": [\"./utils/helpers/*\"]",
            "\t\t}",
            "\t},",
            "\t\"include\": [\"src/**/*\"],",
            "\t\"exclude\": [\"**/node_modules\"]",
            "}"
        ],
        "description": "TypeScript Node.js Backend"
    },
