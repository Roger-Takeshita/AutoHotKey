    "Output JSON Dev": {
        "prefix": "jsonout",
        "body": [
            "if Rails.env.development?",
            "\tdesktop = \"#{File.expand_path('~')}/desktop\"",
            "",
            "\tFile.open(\"#{desktop}/${1:filename}.json\", 'w+') do |f|",
            "\t\tf.write(JSON.pretty_generate(JSON.parse(${0:response}.to_json)))",
            "\tend",
            "end"
        ],
        "description": "Output JSON Dev"
    },
    "Output JSON Date Dev": {
        "prefix": "jsonoutdate",
        "body": [
            "if Rails.env.development?",
            "\tdesktop = \"#{File.expand_path('~')}/desktop\"",
            "\ttime = Time.new",
            "\ttime_str = \"#{time.year}_#{time.month}_#{time.day}-#{time.hour}_#{time.min}_#{time.sec}\"",
            "",
            "\tFile.open(\"#{desktop}/#{time_str}.json\", 'w+') do |f|",
            "\t\tf.write(JSON.pretty_generate(JSON.parse(${0:response}.to_json)))",
            "\tend",
            "end"
        ],
        "description": "Output JSON Date Dev"
    }
