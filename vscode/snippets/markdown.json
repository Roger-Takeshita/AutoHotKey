    "# h1": {
        "prefix": "#",
        "body": [
            "# $1",
            "",
            "[Go Back to Contents](#table-of-contents)",
            "",
            "$0"
        ],
        "description": "# h1"
    },
    "## h2": {
        "prefix": "##",
        "body": [
            "## $1",
            "",
            "[Go Back to Contents](#table-of-contents)",
            "",
            "$0"
        ],
        "description": "## h2"
    },
    "### h3": {
        "prefix": "###",
        "body": [
            "### $1",
            "",
            "[Go Back to Contents](#table-of-contents)",
            "",
            "$0"
        ],
        "description": "### h3"
    },
    "#### h4": {
        "prefix": "####",
        "body": [
            "#### $1",
            "",
            "[Go Back to Contents](#table-of-contents)",
            "",
            "$0"
        ],
        "description": "#### h4"
    },
    "##### h5": {
        "prefix": "#####",
        "body": ["##### $1", "", "$0"],
        "description": "##### h5"
    },
    "~ h1": {
        "prefix": "~",
        "body": [
            "<!-- ~> $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_DAY_NAME -->",
            "",
            "# $CURRENT_YEAR-$CURRENT_MONTH-$CURRENT_DATE $CURRENT_DAY_NAME",
            "",
            "$0"
        ],
        "description": "~ h1"
    },
    "~~ h2": {
        "prefix": "~~",
        "body": [
            "<!-- ~~> $1 -->",
            "",
            "## $1",
            "",
            "[Go Back to Contents](#table-of-contents)",
            "",
            "$0"
        ],
        "description": "~~ h2"
    },
    "~~~ h3": {
        "prefix": "~~~",
        "body": [
            "<!-- ~~~> $1 -->",
            "",
            "### $1",
            "",
            "[Go Back to Contents](#table-of-contents)",
            "",
            "$0"
        ],
        "description": "~~~ h3"
    },
    "~~~~ h4": {
        "prefix": "~~~~",
        "body": [
            "<!-- ~~~~> $1 -->",
            "",
            "#### $1",
            "",
            "[Go Back to Contents](#table-of-contents)",
            "",
            "$0"
        ],
        "description": "~~~~ h4"
    },
    "[Go Back to Contents] Markdown": {
        "prefix": "con",
        "body": ["[Go Back to Contents](#table-of-contents)", "", "$0"],
        "description": "[Go Back to Contents] Markdown"
    },
    "[Go Back to Main] Markdown": {
        "prefix": "back",
        "body": ["[⏮ Go Back to Main](../../README.md)"],
        "description": "[Go Back to Main] Markdown"
    },
    "JavaScript Markdown": {
        "prefix": "javascript",
        "body": ["```JavaScript", "\t$0", "```"],
        "description": "JavaScript Markdown"
    },
    "HTML Markdown": {
        "prefix": "html",
        "body": ["```HTML", "\t$0", "```"],
        "description": "HTML Markdown"
    },
