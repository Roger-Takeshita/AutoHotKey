        "prefix": "ruby",
        "body": ["```Ruby", "\t$0", "```"],
        "description": "Ruby on Rails Markdown"
    },
    "Yaml Markdown": {
        "prefix": "yaml",
        "body": ["```Yaml", "\t$0", "```"],
