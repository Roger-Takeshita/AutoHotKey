    "JSON Markdown": {
        "prefix": "json",
        "body": ["```JSON", "\t$0", "```"],
        "description": "JSON Markdown"
    },
    "SQL Markdown": {
        "prefix": "SQL",
        "body": ["```SQL", "\t$0", "```"],
        "description": "SQL Markdown"
    },
    "TypeScript Markdown": {
        "prefix": "typescript",
        "body": ["```TypeScript", "\t$0", "```"],
        "description": "TypeScript Markdown"
    },
    "CoffeeScript Markdown": {
        "prefix": "coffee",
        "body": ["```Coffee", "\t$0", "```"],
        "description": "CoffeeScript Markdown"
    },
    "C++ Markdown": {
        "prefix": "c++",
        "body": ["```C++", "\t$0", "```"],
