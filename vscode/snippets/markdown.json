    "New Item": {
        "prefix": "!",
        "body": ["${1|In,On|} `$2`", "", "\t$0", ""],
        "description": "New Item"
    },
    "Table of Contents": {
        "prefix": "table",
        "body": [
            "<h1 id='table-of-contents'>TABLE OF CONTENTS</h1>",
            "",
            "- [${1:TITLE}](#$2)",
            "",
            "# ${1:TITLE}",
            "",
            "[Go Back to Contents](#table-of-contents)",
            "",
            "$0"
        ],
        "description": "Table of Contents"
    },
