    "JSON Output": {
        "prefix": "jsono",
        "body": [
            "// Roger-That JSON Output - Begin",
            "const writeFileAsync = async (data, filename, opts = 'utf8') => {",
            "\tconst fs = require('fs');",
            "",
            "\ttry {",
            "\t\tawait new Promise((resolve, reject) => {",
            "\t\t\tconst os = require('os');",
            "\t\t\tconst desktopDir = `\\${os.homedir()}/Desktop`;",
            "",
            "\t\t\tfs.writeFile(`\\${desktopDir}/\\${filename}.json`, JSON.stringify(data, undefined, 2), opts, (err) => {",
            "\t\t\t\tif (err) reject(err);",
            "\t\t\t\telse resolve();",
            "\t\t\t});",
            "\t\t});",
            "\t} catch (error) {",
            "\t\tconsole.error(error);",
            "\t}",
            "};",
            "",
            "await writeFileAsync(${1:response}, '${2:filename}');",
            "// Roger-That JSON Output - End",
            "$0"
        ],
