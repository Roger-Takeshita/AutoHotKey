        // "type": "text",
        "opacity": 100
    },
    "todo-tree.highlights.customHighlight": {
        "~>": {
            "iconColour": "#0066CC",
            "foreground": "#FFFFFF",
            "background": "#0066CC",
            "gutterIcon": true,
            "icon": "git-commit",
            "type": "whole-line"
