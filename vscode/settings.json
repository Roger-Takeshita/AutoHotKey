    "better-comments.multilineComments": true,
    "better-comments.highlightPlainText": true,
    "better-comments.tags": [
        {
            // !
            "tag": "!",
            "color": "#FF2D00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // +
            "tag": "+",
            "color": "#FF8C00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // -
            "tag": "-",
            "color": "#FFFF00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // ?
            "tag": "?",
            "color": "#3399FF",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // >
            "tag": ">",
            "color": "#80D4FF",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // TODO
            "tag": "todo",
            "color": "#FFFF00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // FIX
            "tag": "fix",
            "color": "#FF2D00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // Roger-That-Log
            "tag": "Roger-That-Log",
            "color": "#FF8C00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // Roger-That-Debug
            "tag": "Roger-That-Debug",
            "color": "#FF2D00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // Roger-That
            "tag": "Roger-That",
            "color": "#FFFF00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // DONE
            "tag": "done",
            "color": "#1F7A1F",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // DELETE
            "tag": "delete",
            "color": "#FF2D00",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // *
            "tag": "*",
            "color": "#6FE619",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // &
            "tag": "&",
            "color": "#B7F28C",
            "strikethrough": false,
            "backgroundColor": "transparent"
        },
        {
            // =
            "tag": "=",
            "color": "#FFFFFF",
            "strikethrough": false,
            "backgroundColor": "#FF2D00"
        },
        {
            // _
            "tag": "_",
            "color": "#FFFFFF",
            "strikethrough": false,
            "backgroundColor": "#FF8C00"
        }
    ],
    "todo-tree.filtering.excludeGlobs": [
        "**/node_modules",
        "**/.expo",
        "**/.expo-shared",
        "**/dist",
        "**/public",
        "**/.git",
        "**/coverage",
        "**/.sass-cache",
        "**/node_modules.nosync"
    ],
    "todo-tree.highlights.enabled": true,
    "todo-tree.general.tags": [
        "~>",
        "~~>",
        "~~~>",
        "~~~~>",
        "DONE",
        "DELETE",
        "FIX",
        "TODO",
        "Roger-That",
        "Roger-That-Log",
        "Roger-That-Debug",
        "[ ]",
        "[x]"
